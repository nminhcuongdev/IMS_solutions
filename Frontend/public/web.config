<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config cho SPA (React Router BrowserRouter).

  LƯU Ý: máy này CHƯA cài module "URL Rewrite" nên không dùng <rewrite> được
  (IIS sẽ trả 500.19 nếu khai báo section của module chưa cài).
  Thay vào đó dùng <httpErrors> + responseMode="ExecuteURL" để mọi đường dẫn
  không khớp file tĩnh đều trả về nội dung index.html, để React Router tự định tuyến.

  Đánh đổi: response giữ status 404 (nội dung vẫn đúng, trình duyệt vẫn render).
  Nếu sau này cài URL Rewrite thì thay bằng rule rewrite để có status 200.
-->
<configuration>
  <system.webServer>

    <!-- SPA fallback: deep-link như /masters/zones sẽ trả index.html -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <staticContent>
      <!-- Bổ sung MIME cho các đuôi IIS có thể chưa biết -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <!-- Bật nén tĩnh cho js/css -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

  </system.webServer>

  <location path="assets">
    <system.webServer>
      <!-- File trong /assets có hash trong tên nên cache dài hạn an toàn -->
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="index.html">
    <system.webServer>
      <!-- index.html không được cache, nếu không người dùng sẽ kẹt ở bản cũ -->
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
